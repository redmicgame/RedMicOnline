rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.createdAt is number
        && (!('activeArtistId' in data.keys()) || (data.activeArtistId is string && data.activeArtistId.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(incoming());
        
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['activeArtistId', 'email', 'updatedAt']);
    }

    function isValidArtist(data) {
      return data.keys().hasAll(['ownerId', 'name', 'genre', 'funds', 'popularity', 'energy', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.genre is string && data.genre.size() > 0 && data.genre.size() <= 50
        && data.funds is number
        && data.popularity is number
        && data.energy is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /artists/{artistId} {
      allow get, list: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(artistId)
        && isValidArtist(incoming());

      allow update: if isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidArtist(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'genre', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['funds', 'popularity', 'energy', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']))
        );
    }

    match /global/{docId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    function isValidSong(data) {
      return data.keys().hasAll(['artistId', 'artistName', 'title', 'streams', 'createdAt'])
        && data.artistId is string && data.artistId.size() <= 128
        && data.artistName is string && data.artistName.size() > 0 && data.artistName.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.streams is number
        && data.createdAt is number;
    }

    match /songs/{songId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(songId)
        && isValidSong(incoming());
      allow update: if isSignedIn()
        && isValidSong(incoming())
        && incoming().artistId == existing().artistId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['streams']);
    }

    function isValidAlbum(data) {
      return data.keys().hasAll(['artistId', 'artistName', 'title', 'sales', 'createdAt'])
        && data.artistId is string && data.artistId.size() <= 128
        && data.artistName is string && data.artistName.size() > 0 && data.artistName.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.sales is number
        && data.createdAt is number;
    }

    match /albums/{albumId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(albumId)
        && isValidAlbum(incoming());
      allow update: if isSignedIn()
        && isValidAlbum(incoming())
        && incoming().artistId == existing().artistId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['sales']);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'content', 'likes', 'createdAt'])
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 500
        && data.likes is number
        && data.createdAt is number;
    }

    match /posts/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidPost(incoming());
      allow update: if isSignedIn()
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['likes']);
    }
  }
}
